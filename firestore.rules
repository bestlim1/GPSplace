rules_version = '2';

// GPS 머문 장소 기록 — Firestore 보안 규칙 (NFR-04 위치 정보 접근 제어, FR-01 기기 연결)
// - links와 하위 컬렉션은 연결이 active이고 요청자가 그 연결의 보호자·보호대상자일 때만 읽는다.
// - 위치(pointHours)·체류·알림은 보호대상자만, 구역은 보호자만 쓴다.
// - 연결 해제(released) 뒤에는 둘 다 위치·기록을 읽을 수 없다. 해제할 때 links.lastPoint도 지운다.
// - 연결 코드는 6자리 숫자, 유효 10분, 목록 조회 불가.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function linkData(linkId) {
      return get(/databases/$(database)/documents/links/$(linkId)).data;
    }

    function isMemberActive(linkId) {
      let l = linkData(linkId);
      return signedIn() && l.status == 'active' && (me() == l.guardianUid || me() == l.protectedUid);
    }

    function isProtectedActive(linkId) {
      let l = linkData(linkId);
      return signedIn() && l.status == 'active' && me() == l.protectedUid;
    }

    function isGuardianActive(linkId) {
      let l = linkData(linkId);
      return signedIn() && l.status == 'active' && me() == l.guardianUid;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isPoint(p) {
      return p is map && p.lat is number && p.lng is number && p.t is int;
    }

    // ---- users/{uid}: 본인만 ----
    match /users/{userId} {
      allow read: if signedIn() && me() == userId;
      allow create, update: if signedIn() && me() == userId
        && request.resource.data.keys().hasOnly(['role', 'fcmToken', 'linkId', 'createdAt'])
        && (!('role' in request.resource.data) || request.resource.data.role in ['guardian', 'protected']);
      allow delete: if false;
    }

    // ---- codes/{code}: 연결 코드 (6자리, 10분) ----
    match /codes/{code} {
      function live(c) {
        return request.time < c.createdAt + duration.value(10, 'm');
      }

      function freshCode() {
        let d = request.resource.data;
        return code.matches('^[0-9]{6}$')
          && d.keys().hasOnly(['guardianUid', 'status', 'createdAt', 'expiresAt'])
          && d.guardianUid == me()
          && d.status == 'waiting'
          && d.createdAt == request.time
          && d.expiresAt is timestamp;
      }

      // 정확한 ID로만 읽는다 (목록 조회 불가)
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() && freshCode();

      allow update: if signedIn() && (
        // 보호자: 끝났거나 만료된 번호를 새 코드로 다시 쓴다
        (freshCode() && (resource.data.status in ['consumed', 'denied', 'cancelled'] || !live(resource.data)))
        // 보호자: 대기 중인 자기 코드 취소 (D-04, 새 코드 만들기)
        || (resource.data.guardianUid == me()
            && resource.data.status in ['waiting', 'pending_consent']
            && onlyChanged(['status'])
            && request.resource.data.status == 'cancelled')
        // 보호대상자: 코드 확인 (S-13) → 동의 대기
        || (resource.data.status == 'waiting'
            && live(resource.data)
            && resource.data.guardianUid != me()
            && onlyChanged(['status', 'protectedUid'])
            && request.resource.data.status == 'pending_consent'
            && request.resource.data.protectedUid == me())
        // 보호대상자: 거부 (S-14)
        || (resource.data.status == 'pending_consent'
            && resource.data.protectedUid == me()
            && onlyChanged(['status'])
            && request.resource.data.status == 'denied')
        // 보호대상자: 동의 (S-14) — 같은 일괄 쓰기에서 이 코드를 가리키는 links 문서를 만든다
        || (resource.data.status == 'pending_consent'
            && resource.data.protectedUid == me()
            && live(resource.data)
            && onlyChanged(['status', 'linkId'])
            && request.resource.data.status == 'consumed'
            && getAfter(/databases/$(database)/documents/links/$(request.resource.data.linkId)).data.codeId == code)
      );

      allow delete: if false;
    }

    // ---- links/{linkId} ----
    match /links/{linkId} {
      function validCreate() {
        let d = request.resource.data;
        let c = getAfter(/databases/$(database)/documents/codes/$(d.codeId)).data;
        return d.keys().hasOnly(['guardianUid', 'protectedUid', 'status', 'codeId', 'createdAt', 'pendingCount', 'permission', 'reportedAt'])
          && d.protectedUid == me()
          && d.guardianUid != me()
          && d.status == 'active'
          && d.createdAt == request.time
          && c.status == 'consumed'
          && c.linkId == linkId
          && c.protectedUid == me()
          && c.guardianUid == d.guardianUid;
      }

      function validReport() {
        let d = request.resource.data;
        return onlyChanged(['lastPoint', 'pendingCount', 'permission', 'reportedAt'])
          && (!('lastPoint' in d) || isPoint(d.lastPoint))
          && d.pendingCount is int
          && (!('permission' in d) || d.permission is map);
      }

      function validRelease() {
        let d = request.resource.data;
        return onlyChanged(['status', 'releasedAt', 'lastPoint'])
          && d.status == 'released'
          && d.releasedAt == request.time
          && !('lastPoint' in d);
      }

      // 당사자만. 해제된 문서는 위치가 지워진 뒤에만 보인다 (해제 사실을 상대가 알 수 있게).
      allow get: if signedIn()
        && (me() == resource.data.guardianUid || me() == resource.data.protectedUid)
        && (resource.data.status == 'active' || !('lastPoint' in resource.data));
      allow list: if false;

      allow create: if signedIn() && validCreate();

      allow update: if signedIn() && resource.data.status == 'active' && (
        (me() == resource.data.protectedUid && validReport())
        || ((me() == resource.data.protectedUid || me() == resource.data.guardianUid) && validRelease())
      );

      allow delete: if false;

      // 위치: 1시간 단위 문서. hourKey = "YYYY-MM-DD_HH", dayKey·hour가 일치해야 한다.
      match /pointHours/{hourKey} {
        allow read: if isMemberActive(linkId);
        allow create, update: if isProtectedActive(linkId)
          && hourKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}$')
          && request.resource.data.dayKey == hourKey.split('_')[0]
          && request.resource.data.hour == int(hourKey.split('_')[1])
          && request.resource.data.points is map;
        allow delete: if false;
      }

      match /stays/{stayId} {
        allow read: if isMemberActive(linkId);
        allow create, update: if isProtectedActive(linkId)
          && request.resource.data.keys().hasOnly(['startAt', 'endAt', 'lat', 'lng', 'dayKey', 'durationSec'])
          && request.resource.data.endAt >= request.resource.data.startAt;
        allow delete: if false;
      }

      match /alerts/{alertId} {
        allow read: if isMemberActive(linkId);
        allow create, update: if isProtectedActive(linkId)
          && request.resource.data.type in ['safe_exit', 'caution_enter']
          && isPoint(request.resource.data.p1)
          && isPoint(request.resource.data.p2);
        allow delete: if false;
      }

      // 구역: 보호자만. 이름 1~10자, 종류 safe·caution, 반경 50m~2km (FR-04)
      match /zones/{zoneId} {
        allow read: if isMemberActive(linkId);
        allow create, update: if isGuardianActive(linkId)
          && request.resource.data.keys().hasOnly(['name', 'type', 'lat', 'lng', 'radiusM', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 10
          && request.resource.data.type in ['safe', 'caution']
          && request.resource.data.radiusM is number
          && request.resource.data.radiusM >= 50
          && request.resource.data.radiusM <= 2000
          && request.resource.data.lat is number
          && request.resource.data.lng is number;
        allow delete: if isGuardianActive(linkId);
      }
    }
  }
}
