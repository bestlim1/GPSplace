{
  "name": "gpsplace-functions",
  "private": true,
  "description": "GPS 머문 장소 기록 — 구역 알림 푸시(onAlertCreated)와 Firestore 규칙 테스트",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gpsplace \"mocha --timeout 20000 test/rules.test.mjs\"",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3"
  }
}
